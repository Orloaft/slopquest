{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tib.local/schema/items.schema.json",
  "title": "TIB Items",
  "description": "content/items.yaml — array of inventory items. Cross-references (capabilities, use.item, use.produces/burns) are also checked by scripts/build-content.ts.",
  "type": "array",
  "items": { "$ref": "#/$defs/item" },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Unique snake_case identifier referenced by drops, vendor, quests."
        },
        "label": { "type": "string", "description": "Display name shown to the player." },
        "icon": { "type": "string", "description": "Fallback inventory glyph (short character code)." },
        "iconUrl": {
          "type": ["string", "null"],
          "description": "Path under public/ to the inventory icon image, or null."
        },
        "stackable": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "capabilities": {
          "type": "array",
          "items": { "enum": ["chop_tree", "fish"] },
          "description": "Capabilities this item grants while carried."
        },
        "use": { "$ref": "#/$defs/use" }
      }
    },
    "use": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["eat", "light_fire", "cook_on_fire", "drink_potion"] } },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "eat" },
            "restoreHp": { "type": "number" },
            "buffs": { "type": "array", "items": { "$ref": "#/$defs/buff" } },
            "float": { "type": "string" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "consumesAny"],
          "properties": {
            "kind": { "const": "light_fire" },
            "consumesAny": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item"],
                "properties": {
                  "item": { "type": "string" },
                  "qty": { "type": "number" },
                  "xp": { "type": "number" }
                }
              }
            },
            "skill": { "type": "string" },
            "durationMs": { "type": "number" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "produces", "burns"],
          "properties": {
            "kind": { "const": "cook_on_fire" },
            "produces": { "type": "string" },
            "burns": { "type": "string" },
            "skill": { "type": "string" },
            "xp": { "type": "number" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "restoreHp"],
          "properties": {
            "kind": { "const": "drink_potion" },
            "restoreHp": { "type": "number" },
            "float": { "type": "string" }
          }
        }
      ]
    },
    "buff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationMs"],
      "properties": {
        "id": { "type": "string" },
        "durationMs": { "type": "number" }
      }
    }
  }
}
