{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tib.local/schema/monsters.schema.json",
  "title": "TIB Monsters",
  "description": "content/monsters.yaml — monster catalog. Spawn placements live in spawns.yaml. drop.item references are checked by scripts/build-content.ts.",
  "type": "array",
  "items": { "$ref": "#/$defs/monster" },
  "$defs": {
    "range": {
      "type": "array",
      "description": "[min, max] pair.",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "maxHp", "speed", "damage", "attackMs", "xp", "gold", "aggro", "range"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "description": "Display name." },
        "role": { "enum": ["trash", "pack", "ambush", "turret", "elite", "boss"], "description": "Encounter balance role. If omitted, tools infer one from stats/behavior." },
        "maxHp": { "type": "number" },
        "speed": { "type": "number" },
        "damage": { "$ref": "#/$defs/range" },
        "attackMs": { "type": "number" },
        "xp": { "type": "number" },
        "gold": { "$ref": "#/$defs/range" },
        "aggro": { "type": "number", "description": "Detection range in tiles." },
        "range": { "type": "number", "description": "Melee/magic reach in tiles." },
        "ranged": { "type": "boolean", "description": "Anchored turret that fires projectiles (needs line of sight)." },
        "slowPct": { "type": "number", "description": "Movement-slow percent applied to the hit player." },
        "slowMs": { "type": "number", "description": "Duration of the applied slow in ms." },
        "weakenPct": { "type": "number", "description": "Reduces the hit player's physical damage by this percent." },
        "weakenMs": { "type": "number", "description": "Duration of the weaken debuff in ms." },
        "projectileAnimation": { "type": "string", "description": "Combat animation id for ranged monster attacks." },
        "armor": { "type": "number", "description": "Flat damage reduction on incoming hits." },
        "isUnholy": { "type": "boolean", "description": "Unholy targets grant Faith XP and take Acolyte holy synergies." },
        "faithXp": { "type": "number", "minimum": 0, "description": "Dedicated Faith XP awarded on slaying this unholy monster." },
        "pack": { "type": "boolean", "description": "Aggroing alerts nearby same-type monsters." },
        "burrow": { "type": "boolean", "description": "Hidden until a player steps adjacent, then bursts." },
        "stunMs": { "type": "number", "description": "Stun applied on the burrow ambush, in ms." },
        "heavyAttack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cooldownMs", "windupMs", "damageMultiplier", "radius"],
          "properties": {
            "cooldownMs": { "type": "number", "minimum": 1 },
            "windupMs": { "type": "number", "minimum": 1 },
            "damageMultiplier": { "type": "number", "minimum": 1 },
            "radius": { "type": "number", "minimum": 0.1 }
          }
        },
        "drops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "chance"],
            "properties": {
              "item": { "type": "string", "description": "An item id from items.yaml." },
              "chance": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
