{
  "name": "tib-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "node scripts/build-content.ts",
    "predev": "npm run content:build",
    "predev:tools": "npm run content:build",
    "predev:e2e": "npm run content:build",
    "preserver": "npm run content:build",
    "preclient": "npm run content:build",
    "precheck": "npm run content:build",
    "pretypecheck": "npm run content:build",
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/index.ts\"",
    "dev:tools": "TIB_DEV=1 concurrently \"vite --host 0.0.0.0\" \"node server/index.ts\"",
    "dev:e2e": "E2E_TEST=1 concurrently \"vite --host 127.0.0.1 --port 5173\" \"node server/index.ts\"",
    "client": "vite --host 0.0.0.0",
    "server": "node server/index.ts",
    "load:test": "node scripts/load-test.ts",
    "perf:gate": "node scripts/perf-gate.ts",
    "assets:enemies": "python3 tools/generate_woodland_enemy_sprites_v2.py && python3 tools/validate_enemy_asset_pipeline.py",
    "assets:enemies:check": "python3 tools/validate_enemy_asset_pipeline.py",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/tib-features.spec.ts --project=chromium",
    "typecheck": "tsc",
    "check": "tsc && npm run assets:enemies:check"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "phaser": "^3.90.0",
    "vite": "^6.3.5",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "js-yaml": "^4.1.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
