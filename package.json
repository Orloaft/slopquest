{
  "name": "tib-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "node scripts/build-content.ts",
    "predev": "npm run content:build",
    "predev:tools": "npm run content:build",
    "predev:e2e": "npm run content:build",
    "preserver": "npm run content:build",
    "preclient": "npm run content:build",
    "precheck": "npm run content:build",
    "pretypecheck": "npm run content:build",
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/index.ts\"",
    "dev:tools": "TIB_DEV=1 concurrently \"vite --host 0.0.0.0\" \"node server/index.ts\"",
    "dev:e2e": "E2E_TEST=1 concurrently \"vite --host 127.0.0.1 --port 5173\" \"node server/index.ts\"",
    "client": "vite --host 0.0.0.0",
    "server": "node server/index.ts",
    "load:test": "node scripts/load-test.ts",
    "perf:gate": "node scripts/perf-gate.ts",
    "perf:soak": "node scripts/perf-gate.ts --soak",
    "perf:stress": "node scripts/perf-gate.ts --stress",
    "balance:areas": "node scripts/balance-areas.ts",
    "balance:bands": "node scripts/balance-bands.ts",
    "balance:combat": "node scripts/balance-combat.ts",
    "assets:budget": "node scripts/asset-budget.ts --preload-entry src/main.ts --max-preload-bytes 57671680 --max-preload-files 65",
    "assets:slice:road": "node tools/slice-road-wang.ts",
    "assets:bridge:northwood": "node tools/build-northwood-from-authored.ts",
    "assets:northwood": "npm run assets:bridge:northwood && npm run assets:stage:northwood",
    "assets:stage:northwood": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/northwood/northwood.stage.json --vocab assetsources/asset-forge/northwood.vocab.json --out src/generated/stages/northwood.ts --public-dir public/tilesets/northwood",
    "assets:stage:northwood:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/northwood/northwood.stage.json --vocab assetsources/asset-forge/northwood.vocab.json --out src/generated/stages/northwood.ts --public-dir public/tilesets/northwood --check",
    "assets:bridge:route": "node tools/build-route-from-authored.ts",
    "assets:route": "npm run assets:bridge:route && npm run assets:stage:route",
    "assets:stage:route": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/route/route.stage.json --vocab assetsources/asset-forge/route.vocab.json --out src/generated/stages/route.ts --public-dir public/tilesets/route",
    "assets:stage:route:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/route/route.stage.json --vocab assetsources/asset-forge/route.vocab.json --out src/generated/stages/route.ts --public-dir public/tilesets/route --check",
    "assets:bridge:waystone": "node tools/build-waystone-from-authored.ts",
    "assets:waystone": "npm run assets:bridge:waystone && npm run assets:stage:waystone",
    "assets:stage:waystone": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/waystone/waystone.stage.json --vocab assetsources/asset-forge/waystone.vocab.json --out src/generated/stages/waystone.ts --public-dir public/tilesets/waystone",
    "assets:stage:waystone:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/waystone/waystone.stage.json --vocab assetsources/asset-forge/waystone.vocab.json --out src/generated/stages/waystone.ts --public-dir public/tilesets/waystone --check",
    "assets:wang:swamp": "python3 tools/slice-swamp-wang.py",
    "assets:bridge:swamp": "node tools/build-swamp-from-authored.ts",
    "assets:swamp": "npm run assets:bridge:swamp && npm run assets:stage:swamp",
    "assets:stage:swamp": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/swamp/swamp.stage.json --vocab assetsources/asset-forge/swamp.vocab.json --out src/generated/stages/swamp.ts --public-dir public/tilesets/swamp",
    "assets:stage:swamp:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/swamp/swamp.stage.json --vocab assetsources/asset-forge/swamp.vocab.json --out src/generated/stages/swamp.ts --public-dir public/tilesets/swamp --check",
    "assets:stage:searing-canyon": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/searing-canyon/searing-canyon.stage.json --vocab assetsources/asset-forge/searing-canyon.vocab.json --out src/generated/stages/searing-canyon.ts --public-dir public/tilesets/searing-canyon",
    "assets:stage:searing-canyon:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/searing-canyon/searing-canyon.stage.json --vocab assetsources/asset-forge/searing-canyon.vocab.json --out src/generated/stages/searing-canyon.ts --public-dir public/tilesets/searing-canyon --check",
    "assets:dump:beach": "node tools/dump-floor8-layout.ts",
    "assets:bridge:beach": "node tools/build-beach-from-authored.ts",
    "assets:beach": "npm run assets:bridge:beach && npm run assets:stage:beach",
    "assets:stage:beach": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/beach/beach.stage.json --vocab assetsources/asset-forge/beach.vocab.json --out src/generated/stages/beach.ts --public-dir public/tilesets/beach",
    "assets:stage:beach:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/beach/beach.stage.json --vocab assetsources/asset-forge/beach.vocab.json --out src/generated/stages/beach.ts --public-dir public/tilesets/beach --check",
    "assets:bridge:cemetery": "node tools/build-stage-from-textures.ts --floor 1 --name cemetery",
    "assets:stage:cemetery": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/cemetery/cemetery.stage.json --vocab assetsources/asset-forge/cemetery.vocab.json --out src/generated/stages/cemetery.ts --public-dir public/tilesets/cemetery",
    "assets:stage:cemetery:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/cemetery/cemetery.stage.json --vocab assetsources/asset-forge/cemetery.vocab.json --out src/generated/stages/cemetery.ts --public-dir public/tilesets/cemetery --check",
    "assets:bridge:crypt": "node tools/build-stage-from-textures.ts --floor 2 --name crypt",
    "assets:stage:crypt": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/crypt/crypt.stage.json --vocab assetsources/asset-forge/crypt.vocab.json --out src/generated/stages/crypt.ts --public-dir public/tilesets/crypt",
    "assets:stage:crypt:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/crypt/crypt.stage.json --vocab assetsources/asset-forge/crypt.vocab.json --out src/generated/stages/crypt.ts --public-dir public/tilesets/crypt --check",
    "assets:bridge:northwatch": "node tools/build-stage-from-textures.ts --floor 4 --name northwatch",
    "assets:stage:northwatch": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/northwatch/northwatch.stage.json --vocab assetsources/asset-forge/northwatch.vocab.json --out src/generated/stages/northwatch.ts --public-dir public/tilesets/northwatch",
    "assets:stage:northwatch:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/northwatch/northwatch.stage.json --vocab assetsources/asset-forge/northwatch.vocab.json --out src/generated/stages/northwatch.ts --public-dir public/tilesets/northwatch --check",
    "assets:bridge:desert": "node tools/build-stage-from-textures.ts --floor 7 --name desert",
    "assets:stage:desert": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/desert/desert.stage.json --vocab assetsources/asset-forge/desert.vocab.json --out src/generated/stages/desert.ts --public-dir public/tilesets/desert",
    "assets:stage:desert:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/desert/desert.stage.json --vocab assetsources/asset-forge/desert.vocab.json --out src/generated/stages/desert.ts --public-dir public/tilesets/desert --check",
    "assets:bridge:jungle": "node tools/build-stage-from-textures.ts --floor 9 --name jungle",
    "assets:stage:jungle": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/jungle/jungle.stage.json --vocab assetsources/asset-forge/jungle.vocab.json --out src/generated/stages/jungle.ts --public-dir public/tilesets/jungle",
    "assets:stage:jungle:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/jungle/jungle.stage.json --vocab assetsources/asset-forge/jungle.vocab.json --out src/generated/stages/jungle.ts --public-dir public/tilesets/jungle --check",
    "assets:bridge:deepmine": "node tools/build-stage-from-textures.ts --floor 10 --name deepmine",
    "assets:stage:deepmine": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/deepmine/deepmine.stage.json --vocab assetsources/asset-forge/deepmine.vocab.json --out src/generated/stages/deepmine.ts --public-dir public/tilesets/deepmine",
    "assets:stage:deepmine:check": "node tools/import-asset-forge-stage.ts --stage assetsources/asset-forge/exports/deepmine/deepmine.stage.json --vocab assetsources/asset-forge/deepmine.vocab.json --out src/generated/stages/deepmine.ts --public-dir public/tilesets/deepmine --check",
    "workflow:swamp": "npm run assets:stage:swamp:check && npm run typecheck && playwright test tests/e2e/asset-forge-stage.spec.ts tests/e2e/marsh.spec.ts --project=chromium",
    "workflow:northwood": "npm run assets:stage:northwood:check && npm run typecheck && playwright test tests/e2e/asset-forge-stage.spec.ts tests/e2e/road-safety.spec.ts --project=chromium",
    "workflow:waystone": "npm run assets:stage:waystone:check && npm run typecheck && playwright test tests/e2e/waystone-screenshot.spec.ts --project=chromium",
    "assets:enemies": "python3 tools/generate_woodland_enemy_sprites_v2.py && python3 tools/validate_enemy_asset_pipeline.py",
    "assets:enemies:check": "python3 tools/validate_enemy_asset_pipeline.py",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/tib-features.spec.ts --project=chromium",
    "typecheck": "tsc",
    "check": "tsc && npm run assets:enemies:check && npm run assets:budget && npm run balance:bands"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "phaser": "^3.90.0",
    "vite": "^6.3.5",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "js-yaml": "^4.1.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
