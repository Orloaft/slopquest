{
  "name": "tib-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/index.js\"",
    "dev:e2e": "E2E_TEST=1 concurrently \"vite --host 127.0.0.1 --port 5173\" \"node server/index.js\"",
    "client": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "load:test": "node scripts/load-test.js",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/tib-features.spec.js --project=chromium",
    "check": "node --check server/index.js && node --check src/shared.js && node --check src/main.js && node --check scripts/load-test.js && node --check tests/e2e/tib-features.spec.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "phaser": "^3.90.0",
    "vite": "^6.3.5",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "pngjs": "^7.0.0"
  }
}
